# Application
APP_ENV=development
APP_DEBUG=true

# Backend API (nguồn dữ liệu nghiệp vụ cho repository/)
BACKEND_API_URL=http://localhost:8000
BACKEND_API_TIMEOUT_SECONDS=10

# LangGraph checkpointer (SQLite)
CHECKPOINT_DB_PATH=checkpoints.db

# LLM (Groq)
GROQ_API_KEY=gsk_your_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.0

# Vector store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge

# Embedding & RAG
# BAAI/bge-m3 tốt nhất cho tiếng Việt nhưng nặng (~2.3GB);
# máy yếu có thể đổi sang: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
KNOWLEDGE_DIR=./knowledge
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
